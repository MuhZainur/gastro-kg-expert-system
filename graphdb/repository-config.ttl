# GastroKG repository: OWL 2 RL reasoning with consistency checks.
# GraphDB Workbench: Setup > Repositories > Create from file.
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rep:     <http://www.openrdf.org/config/repository#>.
@prefix sr:      <http://www.openrdf.org/config/repository/sail#>.
@prefix sail:    <http://www.openrdf.org/config/sail#>.
@prefix graphdb: <http://www.ontotext.com/config/graphdb#>.

[] a rep:Repository ;
    rep:repositoryID "gastrokg" ;
    rdfs:label "GastroKG expert system" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:Sail" ;
            graphdb:ruleset "owl2-rl-optimized" ;
            graphdb:disable-sameAs "false" ;
            graphdb:check-for-inconsistencies "true" ;
            graphdb:enable-context-index "true" ;
            graphdb:enablePredicateList "true" ;
            graphdb:base-URL "http://example.org/gastrokg/data#" ;
        ]
    ].
