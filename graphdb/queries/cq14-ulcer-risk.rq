# Which patients are at raised ulcer risk? (union of two defined classes)
PREFIX gk:      <http://example.org/gastrokg/ontology#>
PREFIX gkd:     <http://example.org/gastrokg/data#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?patient WHERE {
  ?p a gk:UlcerRiskPatient .
  BIND(STRAFTER(STR(?p), "#") AS ?patient)
} ORDER BY ?patient
