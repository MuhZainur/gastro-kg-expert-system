# 76-triage-final: Final triage level
# Keep the most urgent level, using the transitive property moreUrgentThan.
# iterate: false
# GENERATED by scripts/build_graphdb.py
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?encounter gk:finalTriage ?level } }
WHERE {
  ?d a gk:TriageDecision ; gk:ofEncounter ?encounter ; gk:triageLevel ?level .
  FILTER NOT EXISTS {
    ?o a gk:TriageDecision ; gk:ofEncounter ?encounter ; gk:triageLevel ?higher .
    ?higher gk:moreUrgentThan ?level .
  }
}
