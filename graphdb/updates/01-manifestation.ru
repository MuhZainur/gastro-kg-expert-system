# 01-manifestation: Disease manifests as symptom
# Direct disease-symptom edges from supporting evidence links.
# iterate: false
# GENERATED by scripts/build_graphdb.py
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?disease gk:manifestsAs ?symptom } }
WHERE {
  ?link a gk:EvidenceLink ; gk:ofDisease ?disease ; gk:aboutSymptom ?symptom ; gk:expertCF ?w .
  FILTER(?w > 0)
}
