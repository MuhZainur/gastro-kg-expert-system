# 60-context-risk: Explain with patient risk factors
# Attach the patient's risk factors that are linked to the disease. They do not change the CF.
# iterate: false
# GENERATED by scripts/build_graphdb.py
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?h gk:contextRiskFactor ?risk } }
WHERE {
  ?h a gk:Hypothesis ; gk:ofEncounter ?encounter ; gk:forDisease ?disease .
  ?encounter gk:encounterOf ?patient .
  ?patient gk:hasRiskFactor ?risk .
  ?risk gk:increasesRiskOf ?disease .
}
