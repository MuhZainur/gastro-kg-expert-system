# 45-status-weak: Match status: weak
# Everything else keeps its CF but is flagged as weak.
# iterate: false
# GENERATED by scripts/build_graphdb.py
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?h gk:matchStatus gkd:WeakMatch } }
WHERE {
  ?h a gk:Hypothesis .
  FILTER NOT EXISTS { ?h gk:matchStatus ?any }
}
