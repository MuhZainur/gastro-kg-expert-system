# 21-cf-first-step: Certainty factor: first step
# The first evidence of a chain sets the combined CF.
# iterate: false
# GENERATED by scripts/build_graphdb.py
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?item gk:cumulativeBefore 0.0 ; gk:cumulativeAfter ?cf } }
WHERE { ?item a gk:EvidenceItem ; gk:sequence 1 ; gk:itemCF ?cf }
