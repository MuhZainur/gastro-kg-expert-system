# 22-cf-next-step: Certainty factor: sequential combination
# Support: old + new x (1 - old). Opposition: old + new x (1 + old). Repeats along the chain.
# iterate: true
# GENERATED by scripts/build_graphdb.py
# Run repeatedly until GraphDB reports 0 added statements.
PREFIX gk:   <http://example.org/gastrokg/ontology#>
PREFIX gkd:  <http://example.org/gastrokg/data#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { GRAPH <urn:gastrokg:inferred> { ?item gk:previousStep ?prevItem ; gk:cumulativeBefore ?old ; gk:cumulativeAfter ?new } }
WHERE {
  ?prevItem a gk:EvidenceItem ; gk:ofHypothesis ?h ; gk:polarity ?p ; gk:sequence ?k ; gk:cumulativeAfter ?old .
  ?item a gk:EvidenceItem ; gk:ofHypothesis ?h ; gk:polarity ?p ; gk:sequence ?n ; gk:itemCF ?cf .
  FILTER(?n = ?k + 1)
  BIND(IF(?p = gkd:Support, ?old + ?cf * (1 - ?old), ?old + ?cf * (1 + ?old)) AS ?new)
}
