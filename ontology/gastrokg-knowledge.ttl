    gk:cautionDrugClass gkd:Opioid ;
    gk:cautionDisease gkd:Gastroparesis ;
    gk:severity "high" ;
    gk:reason "Opioid pain medicines can delay stomach emptying or worsen symptoms."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastroparesis/symptoms-causes> .

