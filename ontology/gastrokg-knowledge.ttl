# ---- IF-THEN diagnostic rules ----
gkd:R1 a gk:DiagnosticRule ;
    rdfs:label "R1: IF G01 AND G02 AND G03 THEN Gastritis"@en ;
    gk:code "R1" ;
    gk:concludes gkd:Gastritis ;
    gk:requiresSymptom gkd:EpigastricPain , gkd:Nausea , gkd:Bloating ;
    dcterms:source gkd:GroupAssignment .

gkd:R2 a gk:DiagnosticRule ;
    rdfs:label "R2: IF G01 AND G03 AND G05 AND G06 THEN Dyspepsia"@en ;
    gk:code "R2" ;
    gk:concludes gkd:Dyspepsia ;
    gk:requiresSymptom gkd:EpigastricPain , gkd:Bloating , gkd:Belching , gkd:EarlySatiety ;
    dcterms:source gkd:GroupAssignment .

gkd:R3 a gk:DiagnosticRule ;
    rdfs:label "R3: IF G01 AND G02 AND G04 AND G07 THEN GERD"@en ;
    gk:code "R3" ;
    gk:concludes gkd:GERD ;
    gk:requiresSymptom gkd:EpigastricPain , gkd:Nausea , gkd:Heartburn , gkd:SourTaste ;
    dcterms:source gkd:GroupAssignment .

gkd:R4 a gk:DiagnosticRule ;
    rdfs:label "R4: IF G01 AND G02 AND G10 THEN PepticUlcer"@en ;
    gk:code "R4" ;
    gk:concludes gkd:PepticUlcer ;
    gk:requiresSymptom gkd:EpigastricPain , gkd:Nausea , gkd:HungerNightPain ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/peptic-ulcers-stomach-ulcers/symptoms-causes> .

gkd:R5 a gk:DiagnosticRule ;
    rdfs:label "R5: IF G02 AND G06 AND G12 THEN Gastroparesis"@en ;
    gk:code "R5" ;
    gk:concludes gkd:Gastroparesis ;
    gk:requiresSymptom gkd:Nausea , gkd:EarlySatiety , gkd:ProlongedFullness ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastroparesis/symptoms-causes> .

gkd:R6 a gk:DiagnosticRule ;
    rdfs:label "R6: IF A03 AND G01 AND G13 THEN StomachCancer"@en ;
    gk:code "R6" ;
    gk:concludes gkd:StomachCancer ;
    gk:requiresSymptom gkd:WeightLoss , gkd:EpigastricPain , gkd:AppetiteLoss ;
    dcterms:source <https://www.cancer.gov/types/stomach/symptoms> .

gkd:R7 a gk:DiagnosticRule ;
    rdfs:label "R7: IF G04 AND G08 THEN GERD"@en ;
    gk:code "R7" ;
    gk:concludes gkd:GERD ;
    gk:requiresSymptom gkd:Heartburn , gkd:Regurgitation ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> .

# ---- Risk factors ----
gkd:HPyloriInfection a gk:RiskFactor ;
    rdfs:label "History of H. pylori infection"@en , "Riwayat infeksi H. pylori"@id ;
    gk:increasesRiskOf gkd:Gastritis , gkd:PepticUlcer , gkd:Dyspepsia ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastritis-gastropathy/symptoms-causes> , <https://www.niddk.nih.gov/health-information/digestive-diseases/peptic-ulcers-stomach-ulcers/symptoms-causes> , <https://www.niddk.nih.gov/health-information/digestive-diseases/indigestion-dyspepsia/symptoms-causes> .

gkd:Smoking a gk:RiskFactor ;
    rdfs:label "Smoking"@en , "Merokok"@id ;
    gk:increasesRiskOf gkd:GERD ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> .

gkd:Obesity a gk:RiskFactor ;
    rdfs:label "Overweight or obesity"@en , "Kelebihan berat badan"@id ;
    gk:increasesRiskOf gkd:GERD ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> .

gkd:Pregnancy a gk:RiskFactor ;
    rdfs:label "Pregnancy"@en , "Kehamilan"@id ;
    gk:increasesRiskOf gkd:GERD ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> .

gkd:AlcoholUse a gk:RiskFactor ;
    rdfs:label "Alcohol use"@en , "Konsumsi alkohol"@id ;
    gk:increasesRiskOf gkd:Gastritis ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastritis-gastropathy/symptoms-causes> .

gkd:Diabetes a gk:RiskFactor ;
    rdfs:label "Diabetes"@en , "Diabetes"@id ;
    gk:increasesRiskOf gkd:Gastroparesis ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastroparesis/symptoms-causes> .

# ---- Medicines and safety knowledge ----
gkd:NSAID a gk:DrugClass ;
    rdfs:label "Non-steroidal anti-inflammatory drug (NSAID)"@en , "Obat antiinflamasi nonsteroid"@id ;
    gk:saferAlternative gkd:Paracetamol .

gkd:Anticoagulant a gk:DrugClass ;
    rdfs:label "Anticoagulant"@en , "Antikoagulan (pengencer darah)"@id .

gkd:Corticosteroid a gk:DrugClass ;
    rdfs:label "Corticosteroid"@en , "Kortikosteroid"@id .

gkd:Opioid a gk:DrugClass ;
    rdfs:label "Opioid pain medicine"@en , "Obat nyeri golongan opioid"@id ;
    gk:saferAlternative gkd:Paracetamol .

gkd:NonOpioidAnalgesic a gk:DrugClass ;
    rdfs:label "Non-opioid analgesic"@en , "Analgesik non-opioid"@id .

gkd:Ibuprofen a gk:Medication ;
    rdfs:label "Ibuprofen"@en ;
    gk:drugClass gkd:NSAID .

gkd:Naproxen a gk:Medication ;
    rdfs:label "Naproxen"@en ;
    gk:drugClass gkd:NSAID .

gkd:Aspirin a gk:Medication ;
    rdfs:label "Aspirin"@en ;
    gk:drugClass gkd:NSAID .

gkd:Warfarin a gk:Medication ;
    rdfs:label "Warfarin"@en ;
    gk:drugClass gkd:Anticoagulant .

gkd:Prednisone a gk:Medication ;
    rdfs:label "Prednisone"@en ;
    gk:drugClass gkd:Corticosteroid .

gkd:Morphine a gk:Medication ;
    rdfs:label "Morphine"@en ;
    gk:drugClass gkd:Opioid .

gkd:Codeine a gk:Medication ;
    rdfs:label "Codeine"@en ;
    gk:drugClass gkd:Opioid .

gkd:Paracetamol a gk:Medication ;
    rdfs:label "Paracetamol"@en ;
    gk:drugClass gkd:NonOpioidAnalgesic .

gkd:DC1 a gk:DrugCaution ;
    rdfs:label "Caution: NSAID in PepticUlcer"@en ;
    gk:cautionDrugClass gkd:NSAID ;
    gk:cautionDisease gkd:PepticUlcer ;
    gk:severity "high" ;
    gk:reason "NSAIDs are a common cause of peptic ulcers."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/peptic-ulcers-stomach-ulcers/symptoms-causes> , <https://www.nhs.uk/medicines/ibuprofen-for-adults/> .

gkd:DC2 a gk:DrugCaution ;
    rdfs:label "Caution: NSAID in Gastritis"@en ;
    gk:cautionDrugClass gkd:NSAID ;
    gk:cautionDisease gkd:Gastritis ;
    gk:severity "high" ;
    gk:reason "Long-term NSAID use can injure the stomach lining."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/gastritis-gastropathy/symptoms-causes> .

gkd:DC3 a gk:DrugCaution ;
    rdfs:label "Caution: NSAID in GERD"@en ;
    gk:cautionDrugClass gkd:NSAID ;
    gk:cautionDisease gkd:GERD ;
    gk:severity "moderate" ;
    gk:reason "NSAIDs can cause or worsen reflux disease."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> .

gkd:DC4 a gk:DrugCaution ;
    rdfs:label "Caution: NSAID in Dyspepsia"@en ;
    gk:cautionDrugClass gkd:NSAID ;
    gk:cautionDisease gkd:Dyspepsia ;
    gk:severity "moderate" ;
    gk:reason "NSAIDs can cause indigestion."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/indigestion-dyspepsia/symptoms-causes> .

gkd:DC5 a gk:DrugCaution ;
    rdfs:label "Caution: Corticosteroid in Dyspepsia"@en ;
    gk:cautionDrugClass gkd:Corticosteroid ;
    gk:cautionDisease gkd:Dyspepsia ;
    gk:severity "moderate" ;
    gk:reason "Corticosteroids can cause indigestion."@en ;
    dcterms:source <https://www.niddk.nih.gov/health-information/digestive-diseases/indigestion-dyspepsia/symptoms-causes> .

gkd:DC6 a gk:DrugCaution ;
