# GastroKG A-Box: expert knowledge. GENERATED by scripts/make_knowledge.py
# Associations cite a public health source where it lists them. Every numeric
# weight is illustrative and has NOT been clinically validated.
@prefix gk:      <http://example.org/gastrokg/ontology#> .
@prefix gkd:     <http://example.org/gastrokg/data#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wd:      <http://www.wikidata.org/entity/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .

<http://example.org/gastrokg/knowledge> a owl:Ontology ;
    rdfs:label "GastroKG knowledge base"@en ;
    owl:imports <http://example.org/gastrokg/ontology> .

# ---- Sources ----
<https://www.niddk.nih.gov/health-information/digestive-diseases/gastritis-gastropathy/symptoms-causes> a dcterms:BibliographicResource ;
    rdfs:label "NIDDK: Symptoms and causes of gastritis and gastropathy"@en .

<https://www.niddk.nih.gov/health-information/digestive-diseases/indigestion-dyspepsia/symptoms-causes> a dcterms:BibliographicResource ;
    rdfs:label "NIDDK: Symptoms and causes of indigestion"@en .

<https://www.niddk.nih.gov/health-information/digestive-diseases/acid-reflux-ger-gerd-adults/symptoms-causes> a dcterms:BibliographicResource ;
    rdfs:label "NIDDK: Symptoms and causes of GER and GERD"@en .

<https://www.niddk.nih.gov/health-information/digestive-diseases/peptic-ulcers-stomach-ulcers/symptoms-causes> a dcterms:BibliographicResource ;
    rdfs:label "NIDDK: Symptoms and causes of peptic ulcers"@en .

<https://www.niddk.nih.gov/health-information/digestive-diseases/gastroparesis/symptoms-causes> a dcterms:BibliographicResource ;
    rdfs:label "NIDDK: Symptoms and causes of gastroparesis"@en .

<https://www.cancer.gov/types/stomach/symptoms> a dcterms:BibliographicResource ;
    rdfs:label "NCI: Stomach cancer symptoms"@en .

<https://pubmed.ncbi.nlm.nih.gov/28631728/> a dcterms:BibliographicResource ;
    rdfs:label "Moayyedi et al. (2017). ACG and CAG clinical guideline: management of dyspepsia"@en .

<https://www.nhs.uk/medicines/nsaids/> a dcterms:BibliographicResource ;
    rdfs:label "NHS: NSAIDs"@en .

<https://www.nhs.uk/medicines/ibuprofen-for-adults/> a dcterms:BibliographicResource ;
    rdfs:label "NHS: Ibuprofen for adults"@en .

<https://www.nhs.uk/medicines/warfarin/> a dcterms:BibliographicResource ;
    rdfs:label "NHS: Warfarin"@en .

gkd:GroupAssignment a dcterms:BibliographicResource ;
    rdfs:label "Group assignment slides and modelling choices (Expert System for Stomach Disease Diagnosis, 2026)"@en .

# ---- Controlled individuals ----
gkd:SlideWeight a gk:WeightStatus ;
    rdfs:label "Illustrative, carried over from our group assignment"@en .

gkd:NewWeight a gk:WeightStatus ;
    rdfs:label "Illustrative, added for the final project"@en .

gkd:FullRuleMatch a gk:MatchStatus ;
    rdfs:label "Full rule match"@en , "Aturan terpenuhi"@id ;
    gk:priority 3 .

gkd:PartialMatch a gk:MatchStatus ;
    rdfs:label "Partial match"@en , "Cocok sebagian"@id ;
    gk:priority 2 .

gkd:WeakMatch a gk:MatchStatus ;
    rdfs:label "Weak match"@en , "Bukti lemah"@id ;
    gk:priority 1 .

gkd:Support a gk:Polarity ;
    rdfs:label "Supports"@en , "Mendukung"@id .

gkd:Oppose a gk:Polarity ;
    rdfs:label "Opposes"@en , "Melawan"@id .

# ---- Care facilities and triage levels ----
gkd:PrimaryCareFacility a gk:CareFacility ;
    rdfs:label "Primary care (FKTP)"@en , "Fasilitas kesehatan tingkat pertama"@id .

gkd:SpecialistClinic a gk:CareFacility ;
    rdfs:label "Specialist clinic with endoscopy"@en , "Klinik spesialis dengan endoskopi"@id .

gkd:EmergencyDepartment a gk:CareFacility ;
    rdfs:label "Emergency department"@en , "Instalasi gawat darurat (IGD)"@id .

gkd:HomeCare a gk:CareFacility ;
    rdfs:label "Self-care at home"@en , "Perawatan mandiri di rumah"@id .

gkd:Emergency a gk:TriageLevel ;
    rdfs:label "Emergency: go now"@en , "Gawat darurat"@id ;
    gk:priority 4 ;
    gk:refersTo gkd:EmergencyDepartment ;
    gk:moreUrgentThan gkd:Urgent .

gkd:Urgent a gk:TriageLevel ;
    rdfs:label "Urgent: see a doctor promptly"@en , "Segera ke dokter"@id ;
    gk:priority 3 ;
    gk:refersTo gkd:PrimaryCareFacility ;
    gk:moreUrgentThan gkd:Referral .

gkd:Referral a gk:TriageLevel ;
    rdfs:label "Referral for endoscopy"@en , "Rujukan endoskopi"@id ;
    gk:priority 2 ;
    gk:refersTo gkd:SpecialistClinic ;
    gk:moreUrgentThan gkd:PrimaryCare .

gkd:PrimaryCare a gk:TriageLevel ;
    rdfs:label "Routine primary care visit"@en , "Kunjungan FKTP rutin"@id ;
    gk:priority 1 ;
    gk:refersTo gkd:PrimaryCareFacility ;
    gk:moreUrgentThan gkd:SelfMonitor .

gkd:SelfMonitor a gk:TriageLevel ;
    rdfs:label "Self-monitor"@en , "Pantau mandiri"@id ;
    gk:priority 0 ;
    gk:refersTo gkd:HomeCare .

gkd:Emergency a gk:TriageLevel .
[ a owl:AllDifferent ; owl:distinctMembers ( gkd:Emergency gkd:Urgent gkd:Referral gkd:PrimaryCare gkd:SelfMonitor ) ] .

gkd:Policy a gk:TriagePolicy ;
    rdfs:label "Screening policy thresholds"@en ;
    gk:referralAge 60 ;
    gk:partialMinSymptoms 2 ;
    gk:partialMinCoverage 0.5 ;
    gk:alertMinCF 0.5 ;
    dcterms:source <https://pubmed.ncbi.nlm.nih.gov/28631728/> , gkd:GroupAssignment ;
    rdfs:comment "Referral age 60 follows the ACG/CAG dyspepsia guideline (a conditional recommendation). The other thresholds are our modelling choices."@en .

# ---- Anatomy (partOf is transitive) ----
gkd:DigestiveSystem a gk:AnatomicalSite ;
    rdfs:label "Digestive system"@en .

gkd:UpperGITract a gk:AnatomicalSite ;
    rdfs:label "Upper gastrointestinal tract"@en ;
    gk:partOf gkd:DigestiveSystem .

gkd:Esophagus a gk:AnatomicalSite ;
    rdfs:label "Esophagus"@en ;
    gk:partOf gkd:UpperGITract .

gkd:Stomach a gk:AnatomicalSite ;
    rdfs:label "Stomach"@en ;
    gk:partOf gkd:UpperGITract .

gkd:StomachLining a gk:AnatomicalSite ;
    rdfs:label "Stomach lining"@en ;
    gk:partOf gkd:Stomach .

# ---- Examinations ----
gkd:UpperEndoscopy a gk:Examination ;
    rdfs:label "Upper gastrointestinal endoscopy"@en .

gkd:HPyloriTest a gk:Examination ;
    rdfs:label "Non-invasive H. pylori test"@en .

gkd:GastricEmptyingStudy a gk:Examination ;
    rdfs:label "Gastric emptying study"@en .

gkd:PHMonitoring a gk:Examination ;
    rdfs:label "Esophageal pH monitoring"@en .

gkd:CompleteBloodCount a gk:Examination ;
    rdfs:label "Complete blood count"@en .

# ---- Symptoms ----
gkd:EpigastricPain a gk:DyspepticSymptom ;
    rdfs:label "Epigastric pain or soreness"@en , "Nyeri atau perih ulu hati"@id ;
    gk:code "G01" ;
    skos:altLabel "ulu hati perih" , "sakit ulu hati" , "nyeri lambung" , "upper stomach pain" .

gkd:Nausea a gk:DyspepticSymptom ;
    rdfs:label "Nausea and urge to vomit"@en , "Mual dan ingin muntah"@id ;
    gk:code "G02" ;
    skos:altLabel "mual" , "enek" , "eneg" , "feeling sick" .

gkd:Bloating a gk:DyspepticSymptom ;
    rdfs:label "Bloating or fullness"@en , "Perut kembung atau terasa penuh"@id ;
    gk:code "G03" ;
    skos:altLabel "kembung" , "begah" , "perut penuh" .

gkd:Heartburn a gk:RefluxSymptom ;
    rdfs:label "Burning sensation in the chest (heartburn)"@en , "Rasa panas di dada"@id ;
    gk:code "G04" ;
    skos:altLabel "dada panas" , "dada terbakar" , "heartburn" .

gkd:Belching a gk:DyspepticSymptom ;
    rdfs:label "Frequent belching"@en , "Sering sendawa"@id ;
    gk:code "G05" ;
    skos:altLabel "sendawa" , "glegekan" , "burping" .

gkd:EarlySatiety a gk:DyspepticSymptom ;
    rdfs:label "Early satiety when eating"@en , "Cepat kenyang saat makan"@id ;
    gk:code "G06" ;
    skos:altLabel "cepat kenyang" , "baru makan sudah kenyang" .

gkd:SourTaste a gk:RefluxSymptom ;
    rdfs:label "Sour vomit or bitter taste in the mouth"@en , "Mulut asam atau pahit"@id ;
    gk:code "G07" ;
    skos:altLabel "mulut pahit" , "mulut asam" .

gkd:Regurgitation a gk:RefluxSymptom ;
    rdfs:label "Regurgitation of food or fluid"@en , "Makanan atau cairan naik kembali"@id ;
    gk:code "G08" ;
    skos:altLabel "asam lambung naik" , "makanan naik lagi" , "acid coming up" .

gkd:CoughHoarseness a gk:RefluxSymptom ;
    rdfs:label "Chronic cough or hoarseness"@en , "Batuk lama atau suara serak"@id ;
    gk:code "G09" ;
    skos:altLabel "batuk lama" , "suara serak" .

gkd:HungerNightPain a gk:DyspepticSymptom ;
    rdfs:label "Upper abdominal pain on an empty stomach or at night"@en , "Nyeri ulu hati saat perut kosong atau malam hari"@id ;
    gk:code "G10" ;
    skos:altLabel "perih saat lapar" , "terbangun malam karena perih" .

gkd:Vomiting a gk:DyspepticSymptom ;
    rdfs:label "Vomiting"@en , "Muntah"@id ;
    gk:code "G11" ;
    skos:altLabel "muntah" , "throwing up" .

gkd:ProlongedFullness a gk:DyspepticSymptom ;
    rdfs:label "Feeling full long after a meal"@en , "Kenyang lama setelah makan"@id ;
    gk:code "G12" ;
    skos:altLabel "kenyang terus" , "makanan lama turun" .

gkd:AppetiteLoss a gk:DyspepticSymptom ;
    rdfs:label "Loss of appetite"@en , "Nafsu makan menurun"@id ;
    gk:code "G13" ;
    skos:altLabel "tidak nafsu makan" , "malas makan" .

gkd:VomitingBlood a gk:BleedingSymptom ;
    rdfs:label "Vomiting blood or coffee-ground material"@en , "Muntah darah atau seperti ampas kopi"@id ;
    gk:code "A01" ;
    skos:altLabel "muntah darah" , "hematemesis" .

gkd:BlackStool a gk:BleedingSymptom ;
    rdfs:label "Black, tarry or bloody stool"@en , "BAB hitam seperti aspal atau berdarah"@id ;
    gk:code "A02" ;
    skos:altLabel "bab hitam" , "berak darah" , "melena" .

gkd:WeightLoss a gk:AlarmSymptom ;
    rdfs:label "Unintentional weight loss"@en , "Berat badan turun tanpa sebab"@id ;
    gk:code "A03" ;
    skos:altLabel "berat badan turun" , "makin kurus" .

gkd:Dysphagia a gk:AlarmSymptom ;
    rdfs:label "Difficult or painful swallowing"@en , "Sulit atau nyeri menelan"@id ;
    gk:code "A04" ;
    skos:altLabel "susah menelan" , "sakit menelan" , "disfagia" .

gkd:PersistentVomiting a gk:AlarmSymptom ;
    rdfs:label "Persistent or frequent vomiting"@en , "Muntah terus-menerus"@id ;
    gk:code "A05" ;
    skos:altLabel "muntah terus" .

gkd:SevereAbdominalPain a gk:EmergencySymptom ;
    rdfs:label "Sudden, severe or constant abdominal pain"@en , "Nyeri perut hebat mendadak atau menetap"@id ;
    gk:code "A06" ;
    skos:altLabel "perut sakit sekali" , "nyeri hebat" .

gkd:Fainting a gk:EmergencySymptom ;
    rdfs:label "Fainting, dizziness or rapid pulse"@en , "Pingsan, pusing berat atau nadi cepat"@id ;
    gk:code "A07" ;
    skos:altLabel "pingsan" , "mau pingsan" .

gkd:Jaundice a gk:AlarmSymptom ;
    rdfs:label "Yellow eyes or skin"@en , "Mata atau kulit kuning"@id ;
    gk:code "A08" ;
    skos:altLabel "mata kuning" , "jaundice" .

gkd:ChestJawArmPain a gk:EmergencySymptom ;
    rdfs:label "Pain in the chest, jaw, neck or arm"@en , "Nyeri dada, rahang, leher atau lengan"@id ;
    gk:code "A09" ;
    skos:altLabel "nyeri dada" , "chest pain" .

# ---- Diseases ----
gkd:Gastritis a gk:InflammatoryDisease ;
    rdfs:label "Gastritis (acute)"@en , "Gastritis (akut)"@id ;
    gk:code "P01" ;
    gk:icd10Code "K29.1" ;
    gk:affects gkd:StomachLining ;
    gk:suggestsExamination gkd:HPyloriTest ;
    gk:initialAdvice "Avoid alcohol and anti-inflammatory painkillers until a clinician has reviewed the complaint."@en ;
    skos:broadMatch wd:Q183130 ;
    skos:broadMatch obo:DOID_4029 .

gkd:Dyspepsia a gk:FunctionalDisorder ;
    rdfs:label "Dyspepsia (functional)"@en , "Dispepsia (fungsional)"@id ;
    gk:code "P02" ;
    gk:icd10Code "K30" ;
    gk:affects gkd:UpperGITract ;
    gk:suggestsExamination gkd:HPyloriTest ;
    gk:initialAdvice "Note the foods that trigger symptoms, eat smaller meals and return if symptoms persist."@en ;
    skos:closeMatch wd:Q653971 .

gkd:GERD a gk:RefluxDisease ;
    rdfs:label "GERD (gastroesophageal reflux disease)"@en , "GERD (penyakit refluks gastroesofagus)"@id ;
    gk:code "P03" ;
    gk:icd10Code "K21" ;
    gk:affects gkd:Esophagus ;
    gk:suggestsExamination gkd:PHMonitoring ;
    gk:initialAdvice "Avoid lying down soon after meals, raise the head of the bed and discuss acid suppression with a clinician."@en ;
    skos:exactMatch wd:Q223591 ;
    skos:exactMatch obo:DOID_8534 .

gkd:PepticUlcer a gk:UlcerDisease ;
    rdfs:label "Peptic (stomach) ulcer"@en , "Tukak lambung"@id ;
    gk:code "P04" ;
    gk:icd10Code "K25" ;
    gk:affects gkd:StomachLining ;
    gk:suggestsExamination gkd:HPyloriTest , gkd:UpperEndoscopy ;
    gk:initialAdvice "See a clinician for H. pylori testing and a review of painkiller use."@en ;
    skos:broadMatch wd:Q172941 ;
    skos:broadMatch obo:DOID_750 .

gkd:Gastroparesis a gk:MotilityDisorder ;
    rdfs:label "Gastroparesis"@en , "Gastroparesis"@id ;
    gk:code "P05" ;
    gk:icd10Code "K31.8" ;
    gk:affects gkd:Stomach ;
    gk:suggestsExamination gkd:GastricEmptyingStudy ;
    gk:initialAdvice "Eat small frequent meals, check blood glucose if diabetic and ask for a gastric emptying assessment."@en ;
    skos:exactMatch wd:Q943897 .

gkd:StomachCancer a gk:MalignantNeoplasm ;
    rdfs:label "Stomach cancer"@en , "Kanker lambung"@id ;
    gk:code "P06" ;
    gk:icd10Code "C16" ;
    gk:affects gkd:Stomach ;
    gk:suggestsExamination gkd:UpperEndoscopy , gkd:CompleteBloodCount ;
    gk:initialAdvice "This screen cannot confirm or exclude cancer. Arrange a specialist assessment."@en ;
    skos:exactMatch wd:Q189588 .

[ a owl:AllDifferent ; owl:distinctMembers ( gkd:Gastritis gkd:Dyspepsia gkd:GERD gkd:PepticUlcer gkd:Gastroparesis gkd:StomachCancer ) ] .

