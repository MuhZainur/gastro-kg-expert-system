# ---- E001: Worked example from our slides ----
gkd:PT001 a gk:Patient ;
    rdfs:label "Synthetic patient PT001 (34 y)"@en ;
    gk:age 34 ;
    gk:hadEncounter gkd:E001 .

gkd:E001 a gk:Encounter ;
    rdfs:label "E001: Worked example from our slides"@en ;
    gk:hasObservation gkd:E001_obs_G01 , gkd:E001_obs_G02 , gkd:E001_obs_G04 , gkd:E001_obs_G07 .

gkd:E001_obs_G01 a gk:SymptomObservation ;
    rdfs:label "E001 has epigastric pain or soreness (1.0)"@en ;
    gk:observedSymptom gkd:EpigastricPain ;
    gk:userCF 1.0 .

gkd:E001_obs_G02 a gk:SymptomObservation ;
    rdfs:label "E001 has nausea and urge to vomit (0.8)"@en ;
    gk:observedSymptom gkd:Nausea ;
    gk:userCF 0.8 .

gkd:E001_obs_G04 a gk:SymptomObservation ;
    rdfs:label "E001 has burning sensation in the chest (heartburn) (1.0)"@en ;
    gk:observedSymptom gkd:Heartburn ;
    gk:userCF 1.0 .

gkd:E001_obs_G07 a gk:SymptomObservation ;
    rdfs:label "E001 has sour vomit or bitter taste in the mouth (0.6)"@en ;
    gk:observedSymptom gkd:SourTaste ;
    gk:userCF 0.6 .

